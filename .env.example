# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://library:library@localhost:5432/library
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Optional SMTP settings for future email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
